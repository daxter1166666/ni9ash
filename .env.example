# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LIVEKIT CONFIGURATION (Audio Only Rooms)
# For LiveKit Cloud (e.g., wss://my-project.livekit.cloud) or self-hosted server
LIVEKIT_URL="wss://your-livekit-domain.livekit.cloud"
LIVEKIT_API_KEY="APIxxxxxxxxxxxx"
LIVEKIT_API_SECRET="secretxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
LIVEKIT_WEBHOOK_SECRET="secretxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# VOICE ROOM SETTINGS
# VOICE_ONLY_MODE: Set to "true" to lock room creation to Voice only. Set to "false" to let hosts choose between Text and Voice.
VOICE_ONLY_MODE="false"

# VOICE_ROOM_MAX_DURATION_MINUTES: Maximum time in minutes a voice room can run before auto-concluding (default: 120)
VOICE_ROOM_MAX_DURATION_MINUTES="120"

# VOICE_ROOM_MAX_AUDIENCE: Maximum spectator capacity per voice room (default: 100)
VOICE_ROOM_MAX_AUDIENCE="100"
